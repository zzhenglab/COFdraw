* text=auto eol=lf
# Preserve upstream license text byte-for-byte, including intentional spacing.
docs/third-party-licenses/* -text -whitespace
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json -text whitespace=cr-at-eol
# Preserve checksum-bound simulation profiles and upstream resource files.
data/raspa/* -text
*.png binary
*.ico binary
